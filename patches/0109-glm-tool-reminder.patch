+# technigmaai/glm-5.3-flash-gb10-tp2-native#3's reminder, verbatim
+TOOL_REMINDER = ("<|user|>Continue the original task using the latest tool result. Before your next answer or tool "
+                 "call, briefly assess the result in the thinking block. Keep that assessment separate from the "
+                 "user-facing answer.")
+
+
+def tool_reminder_enabled() -> bool:
+    """``TF_GLM_TOOL_REMINDER`` (default 1): a chat that ends on a tool result is asked to think before it goes on."""
+
+    value = os.environ.get("TF_GLM_TOOL_REMINDER", "1").strip() or "1"
+    if value not in ("0", "1"):
+        raise ValueError(f"TF_GLM_TOOL_REMINDER={value!r}: expected 0 or 1")
+    return value == "1"
+
+
+def _ends_on_tool(messages: Any) -> bool:
+    return isinstance(messages, list) and bool(messages) and isinstance(messages[-1], dict) \
+        and messages[-1].get("role") == "tool"
+
+
+def tool_reminder(text: str, messages: Any, thinking: bool, asked: Any = None) -> str:
+    """The checkpoint text with a user turn asking for an assessment in the think block just before the generation
+    prompt, when thinking is on and the chat ends on a tool result: there GLM-5.3 tends to close the block at once
+    (``</think>`` first, no reasoning). ``asked`` is the request's ``chat_template_kwargs.tool_reasoning_reminder``:
+    true or false, anything else the server's TF_GLM_TOOL_REMINDER. Only the generation prompt carries it, so the chat
+    renders as before on the next turn. Text not ending in the opened think block is returned as is."""
+
+    if not thinking or not text.endswith(OPENED) or not _ends_on_tool(messages):
+        return text
+    if not (asked if isinstance(asked, bool) else tool_reminder_enabled()):
+        return text
+    return text[:-len(OPENED)] + TOOL_REMINDER + OPENED
+
